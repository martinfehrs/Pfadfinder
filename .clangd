CompileFlags:
    Add:
        - -std=c++20
        - -stdlib=libstdc++

Diagnostics:
    UnusedIncludes: Strict

Hover:
    ShowAKA: true

InlayHints:
    Enabled: true
    BlockEnd: true
    ParameterNames: true
    DeducedTypes: true
    Designators: true
    DefaultArguments: true

Completion:
    AllScopes: true
    HeaderInsertion: Never

Index:
    Background: true
    StandardLibrary: true

Documentation:
    CommentFormat: Doxygen
