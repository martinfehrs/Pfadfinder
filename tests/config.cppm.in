export module config;

/**
 * @brief Aufzählung der unterstützten Betriebssysteme
 */
export enum class system
{
    windows,
    linux,
    macos
};

/**
 * @brief Aktuelles Betriebssystem, zur Compile-Zeit bestimmt
 */
export inline constexpr system current_system = system::@CURRENT_SYSTEM@;
