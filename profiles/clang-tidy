[settings]
os={{ detect_api.detect_os() }}
arch={{ detect_api.detect_arch() }}
build_type=Release
compiler=clang
compiler.version=22
compiler.cppstd=20
# libstdc++11 (neuer ABI): ohne CMakeToolchain kompiliert clang++ die Tests mit
# dem Default-ABI, conan muss Catch2 passend bauen (libstdc++ wäre alter ABI)
compiler.libcxx={{ "libc++" if detect_api.detect_os() == "Macos" else "libstdc++11" }}

[conf]
tools.cmake.cmaketoolchain:generator=Ninja
tools.build:compiler_executables={'c': 'clang', 'cpp': 'clang++'}
